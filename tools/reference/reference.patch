+// seed reference build: the PDU's octets as lowercase hex
+static void seed_append_hex(la_vstring *vstr, char const *key, uint8_t const *buf, size_t len) {
+	char *hex = XCALLOC(2 * len + 1, sizeof(char));
+	for(size_t i = 0; i < len; i++) {
+		snprintf(hex + 2 * i, 3, "%02x", buf[i]);
+	}
+	la_json_append_string(vstr, key, hex);
+	XFREE(hex);
+}
