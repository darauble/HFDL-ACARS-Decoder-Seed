--- a/src/hfdl.c
+++ b/src/hfdl.c
@@ -10,6 +10,7 @@
 #include <pthread.h>                // pthread_mutex_*
 #endif
 #include <string.h>                 // memcpy
+#include <stdlib.h>                 // getenv, atof
 #include <sys/time.h>               // struct timeval
 #include <liquid/liquid.h>
 #include "config.h"                 // *_DEBUG
@@ -806,6 +807,14 @@ static void *hfdl_decoder_thread(void *ctx) {
 						// of the prekey and two A sequences, so that the timestamp
 						// points at the start of the frame.
 						gettimeofday(&c->pdu_timestamp, NULL);
+						// seed reference build: time from the sample count when HFDL_SAMPLE_CLOCK_BASE
+						// (epoch seconds of the recording's first sample) is set
+						char const *base_env = getenv("HFDL_SAMPLE_CLOCK_BASE");
+						if(base_env != NULL) {
+							double t = atof(base_env) + (double)c->sample_cnt / (double)(HFDL_SYMBOL_RATE * SPS);
+							c->pdu_timestamp.tv_sec = (time_t)t;
+							c->pdu_timestamp.tv_usec = (suseconds_t)((t - (double)(time_t)t) * 1e6);
+						}
 						timersub(&c->pdu_timestamp, &ts_correction, &c->pdu_timestamp);
 						chan_debug("A2 sequence found at sample %" PRIu64 " (corr=%f retry=%d costas_dphi=%f)\n",
 								c->sample_cnt, corr_A2, c->search_retries, c->loop->dphi);
