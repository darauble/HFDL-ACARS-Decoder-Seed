{
 "suite": "parse-apps",
 "normative": true,
 "description": "An ACARS message's direction, label and text (after reassembly; the sublabel and MFI still in it) -> the application decoded (spec/03-domain/acars.md \u00a74, applications.md), in the vocabulary of libacars' JSON output (F-H19). `decoded: null`: no application recognises the text. Each text is decoded alone, without reassembly (that is `parse/sequence.json` and `parse/acars.json`), so reassembly statuses are not compared here.",
 "compare": {
  "method": "every key of expected present with an equal value; keys not in expected ignored; non_normative_keys not compared",
  "non_normative_keys": [
   "descr",
   "name",
   "msg_type",
   "reasm_status"
  ],
  "float_abs_tolerance": 1e-05
 },
 "cases": [
