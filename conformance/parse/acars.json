{
 "suite": "parse-acars",
 "normative": true,
 "description": "ACARS blocks (the octets after SOH, as in an enveloped-data HFNPDU) parsed in order with reassembly (spec/03-domain/acars.md), t in seconds -> each block's result, in libacars' JSON vocabulary (F-H19).",
 "compare": {
  "method": "every key of expected present with an equal value; keys not in expected ignored",
  "non_normative_keys": [
   "descr",
   "name",
   "msg_type"
  ],
  "float_abs_tolerance": 1e-05
 },
 "cases": [
  {
   "id": "single-h1-sublabel-mfi",
   "source": "synthetic",
   "description": "one downlink H1 block with sublabel CF and MFI 5Z: final, skipped",
   "input": {
    "blocks": [
     {
      "t": 0,
      "direction": "downlink",
      "octets": "3252c137b337b53215c831b602c4b031c1d3d531b0b0b3234346c22fb5da2045cec720312046495245204c4f4fd020c22046c1d54c5483d0f07f"
     }
    ]
   },
   "expected": {
    "blocks": [
     {
      "acars": {
       "err": false,
       "crc_ok": true,
       "more": false,
       "reassembly": "skipped",
       "reg": "RA73752",
       "mode": "2",
       "label": "H1",
       "blk_id": "6",
       "ack": "!",
       "flight": "SU1003",
       "msg_num": "D01",
       "msg_num_seq": "A",
       "sublabel": "CF",
       "mfi": "5Z",
       "msg_text": "ENG 1 FIRE LOOP B FAULT"
      }
     }
    ]
   },
   "req": [
    "PAR-01",
    "PAR-04"
   ]
  },
